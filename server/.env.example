# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/zonal_assessment

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Server
PORT=5000
CLIENT_URL=http://localhost:5173

# Cloudinary (cloud photo storage) - create a free account at cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Seed super admin (used by npm run seed) - can create other zonal heads
SEED_SUPERADMIN_NAME=System Super Admin
SEED_SUPERADMIN_EMAIL=superadmin@example.com
SEED_SUPERADMIN_PASSWORD=ChangeMe123!

# Seed zonal head admin (used by npm run seed)
SEED_ADMIN_NAME=Dibakar Paudel
SEED_ADMIN_EMAIL=dibakar.paudel@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
